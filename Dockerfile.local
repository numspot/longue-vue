# INTERNAL ONLY: UI-enabled image for authorized NumSpot use.
# Run `make docker-build-ui` to generate the private dependency first.
# Dockerfile.local.dockerignore admits only the pinned local archive; the public
# Dockerfile/context excludes all generated dependencies. Do not export this
# image or its build cache to a public registry/cache.

ARG GO_VERSION=1.26
ARG NODE_VERSION=22-alpine

FROM node:${NODE_VERSION} AS ui-build
WORKDIR /src/ui
COPY ui/package.json ui/package-lock.json ./
# Generated locally with `make ui-design-system`; never committed.
COPY ui/.generated/ ./.generated/
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM golang:${GO_VERSION} AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN rm -rf ui/dist
COPY --from=ui-build /src/ui/dist ./ui/dist

ARG VERSION=docker
ARG TARGETOS
ARG TARGETARCH

RUN CGO_ENABLED=0 \
    GOOS=${TARGETOS:-linux} \
    GOARCH=${TARGETARCH:-amd64} \
    go build \
        -trimpath \
        -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/longue-vue \
        ./cmd/longue-vue

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/longue-vue /longue-vue
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/longue-vue"]
